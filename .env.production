# ============ 生产环境 ============
# npm run build 默认加载（等价于 vite --mode production）

VITE_APP_ENV=production
VITE_APP_TITLE=生产环境

# 生产环境建议保持 /api，由 nginx 反向代理转发（见 nginx.conf.template 的 BACKEND_URL）
# 若需前端直连后端，可改为完整地址，如 https://api.example.com
VITE_API_BASE_URL=/api

# 后端服务地址（域名或 IP）。
# 注意：生产构建不使用 vite proxy，此值仅作记录；
# 实际部署请通过 docker run -e BACKEND_URL=... 或 nginx 环境变量注入
VITE_API_TARGET=https://api.example.com
