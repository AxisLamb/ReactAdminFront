# ============ 开发环境 ============
# npm run dev 默认加载（等价于 vite --mode development）

# 环境标识（可在代码中通过 import.meta.env.VITE_APP_ENV 读取）
VITE_APP_ENV=development
# 环境名称（用于展示）
VITE_APP_TITLE=开发环境

# 浏览器端请求的 API 前缀，一般保持 /api，由 vite 开发代理转发到后端
VITE_API_BASE_URL=/api

# 后端服务地址（域名或 IP），作为 vite 开发代理的 target
# 修改此项即可切换本地联调的后端服务器
VITE_API_TARGET=http://localhost:8888
