# ============ 环境变量模板 ============
# 复制本文件为 .env.[环境名] 并按需修改，例如：
#   .env.development  -> 开发环境（vite 默认）
#   .env.test         -> 测试环境（vite --mode test）
#   .env.production   -> 生产环境（vite build 默认）
# 私有配置（不入库）可放 .env.[环境名].local，其优先级最高

# 环境标识（代码中通过 import.meta.env.VITE_APP_ENV 读取）
VITE_APP_ENV=development
# 环境名称（用于展示）
VITE_APP_TITLE=开发环境

# 浏览器端请求的 API 前缀，一般保持 /api（由 vite 开发代理 / nginx 转发到后端）
# 若需直连后端，可改为完整地址，如 https://api.example.com
VITE_API_BASE_URL=/api

# 后端服务地址（域名或 IP），vite 开发代理使用，如 http://localhost:8888
VITE_API_TARGET=http://localhost:8888
